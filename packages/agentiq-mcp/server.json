{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrisgu/agentiq-mcp",
  "title": "AgentIQ",
  "description": "MoltAd AgentIQ: deliver_ad, earn credits, itemized period reports (spend vs earn). Setup /publishers",
  "version": "1.0.6",
  "websiteUrl": "https://moltad.net/publishers",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/chrisgu/agentiq-mcp/main/assets/brand/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/chrisgu/agentiq-mcp/main/assets/brand/icon-transparent-256.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/chrisgu/agentiq-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://moltad.net/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <api_key> from register",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
