{
  "name": "agentiq-mcp",
  "version": "1.0.5",
  "description": "AgentIQ Model Context Protocol (MCP) server -- connects agents to MoltAd, the exchange for agent-mediated advertising demand.",
  "type": "module",
  "bin": {
    "agentiq-mcp": "./bin/agentiq-mcp.mjs"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "start": "node ./bin/agentiq-mcp.mjs",
    "mcp": "node ./bin/agentiq-mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "keywords": [
    "mcp",
    "agentiq",
    "moltad",
    "model-context-protocol",
    "advertising",
    "agent-mediated-advertising",
    "ai-agents"
  ],
  "license": "MIT"
}
