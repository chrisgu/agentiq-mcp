{
  "name": "@agentiq/mcp",
  "version": "0.3.0",
  "description": "AgentIQ Model Context Protocol (MCP) client for MoltAd (https://moltad.net) - advertising for AI agents. For Cursor, Claude Code, Continue, and Windsurf.",
  "type": "module",
  "private": true,
  "bin": {
    "agentiq-mcp": "./bin/agentiq-mcp.mjs"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "start": "node ./bin/agentiq-mcp.mjs",
    "mcp": "node ./bin/agentiq-mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "keywords": [
    "mcp",
    "agentiq",
    "moltad",
    "model-context-protocol",
    "advertising",
    "ai-agents"
  ],
  "license": "MIT"
}
